# Copiar a .env y rellenar. NUNCA commitear .env real.
AWS_REGION=us-west-2
# Opcion A (profesional): RDS via Secrets Manager
DB_SECRET_ARN=
S3_BACKUP_BUCKET=
# Opcion B (fallback local): postgres del compose
DB_HOST=db
DB_PORT=5432
DB_NAME=iot
DB_USER=iot
DB_PASSWORD=cambiar-esto
# Seguridad: API-Key + HMAC (firmware y backend comparten estos dos)
DEVICE_API_KEY=cambiar-api-key-larga
HMAC_SECRET=cambiar-hmac-largo
MAX_SKEW_S=300
