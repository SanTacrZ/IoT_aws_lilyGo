/* Plantilla de credenciales del nodo. Copiala como secrets.h y rellenala:
 *
 *   cp secrets.h.example secrets.h
 *
 * Los valores deben ser los MISMOS que DEVICE_API_KEY y HMAC_SECRET del
 * servidor (.env). El repositorio es publico: nunca subas el secrets.h real.
 */
#pragma once

#define WIFI_SSID      "NOMBRE_DE_TU_WIFI_2_4_GHZ"
#define WIFI_PASSWORD  "CONTRASENA_DE_TU_WIFI"
#define DEVICE_API_KEY "PEGAR_AQUI_LA_API_KEY"
#define HMAC_SECRET    "PEGAR_AQUI_EL_SECRETO_HMAC"

/* Opcional, solo con URL_SERVIDOR https://: certificado raiz (PEM) que firma
 * el certificado del servidor. Sin esto el nodo cifra pero no verifica a quien
 * le habla (setInsecure), y un MITM en el Wi-Fi podria hacerse pasar por el.
 *
 * #define SERVER_CA_PEM "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
 */

/* Servidor al que publica el nodo (por defecto, el local de main.cpp).
 * #define URL_SERVIDOR_NODO "http://IP-DEL-SERVIDOR:5000/api/plantas"
 */
