# ============================================================================
#  IoT FIWARE + Agente IA  --  configuracion
#  Copiar a .env y rellenar. NUNCA subir .env a git (esta en .gitignore).
# ============================================================================

# --- FIWARE -----------------------------------------------------------------
ORION_HOST=orion
ORION_PORT=1026

# --- PostgreSQL / TimescaleDB (historial de lecturas) ----------------------
POSTGRES_DB=iot
POSTGRES_USER=iot
# Obligatoria. Generar: python3 -c "import secrets;print(secrets.token_hex(24))"
# (DB_URL ya no se define: compose la arma con estas tres variables.)
POSTGRES_PASSWORD=PEGAR_AQUI_UNA_CONTRASENA_LARGA

# --- Seguridad dispositivo -> servidor -------------------------------------
# El firmware (src/main.cpp) y el simulador usan ESTOS MISMOS valores.
# Generar: python3 -c "import secrets;print(secrets.token_hex(32))"
DEVICE_API_KEY=PEGAR_AQUI_LA_API_KEY_DEL_DISPOSITIVO
HMAC_SECRET=PEGAR_AQUI_EL_SECRETO_HMAC
MAX_SKEW_S=300
RATE_LIMIT_POR_MIN=12          # por clave de dispositivo
RATE_LIMIT_IP_POR_MIN=30       # por IP, se aplica ANTES de autenticar

# Una clave por dispositivo, separadas por coma. Si filtran una, el resto sigue
# intacto. Si se deja vacio, cae en DEVICE_API_KEY.
DEVICE_API_KEYS=

# RECOMENDADO: credenciales por nodo "id:api_key:hmac_secret", separadas por
# coma. Atan cada clave a su dispositivo y mandan sobre las dos de arriba.
# No las escribas a mano:  python3 scripts/nuevo_nodo.py <id-del-nodo>
DEVICE_CREDENTIALS=
# Clave de solo lectura para los GET del dashboard (/api/nodos).
READ_API_KEY=PEGAR_AQUI_UNA_CLAVE
# Firma v1 (sin URL) solo para firmware viejo durante la transicion. 0 = rechazada.
FIRMA_V1_PERMITIDA=0

# --- Autenticacion de las interfaces web ----------------------------------
# Dashboard (puerto 8080) con HTTP basica. Para abrirlo desde el celular:
#   http://<WEB_USER>:<WEB_PASSWORD>@10.8.150.228:8080/dashboard/
WEB_USER=admin
WEB_PASSWORD=PEGAR_AQUI_UNA_CONTRASENA
WEB_SESSION_SECRET=PEGAR_AQUI_UN_SECRETO

# Clave para disparar un analisis del agente a mano (POST /api/agente/analizar).
AGENT_API_KEY=PEGAR_AQUI_UNA_CLAVE

# --- Agente IA (Gemini) -----------------------------------------------------
# >>> PEGAR AQUÍ TU API KEY DE GEMINI <<<
# Se puede dejar vacio: el agente queda en modo degradado y no llama a Gemini.
GEMINI_API_KEY=
# Google retira modelos y tiene picos de demanda: si el preferido falla con
# 404/429/5xx el agente prueba el siguiente de la lista.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest
GEMINI_REINTENTOS=2
GEMINI_MAX_TOKENS=4096
AGENT_INTERVAL_MIN=15
# Cuanto mira hacia atras el agente en cada analisis (minutos).
AGENT_VENTANA_MIN=180
# Cuanto espera para considerar que el sensor esta muerto (minutos).
AGENT_SILENCIO_MIN=30

# --- TLS (opcional, perfil docker "tls") ------------------------------------
# Con esto el firmware puede enviar por https:// en vez de http://
# Activar:  docker compose --profile tls up -d
DOMAIN=cultivo.tudominio.com

# --- Grafana ----------------------------------------------------------------
# Grafana queda en 127.0.0.1:3000; desde otro equipo: ssh -L 3000:localhost:3000 <servidor>
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=PEGAR_AQUI_UNA_CONTRASENA

# --- Alertas (alert-agent) --------------------------------------------------
# Telegram: crea el bot con @BotFather (/newbot) y pega el token. Escribele
# /start al bot: si tu chat no esta autorizado te responde tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# WhatsApp Cloud API (Meta). Fuera de la ventana de 24 h solo admite plantillas.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
# SMS por Twilio: solo para escalar alertas criticas sin reconocer.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=
# Canales por nivel (los no configurados se saltan; sin ninguno -> solo bitacora)
ALERT_CANALES_AVISO=telegram,whatsapp
ALERT_CANALES_ESCALADO=sms
ALERT_RECORDATORIO_MIN=60     # recordar una alerta abierta sin /ack
ALERT_ESCALAR_MIN=10          # critica sin /ack -> canal de escalado
ALERT_NODO_CAIDO_MIN=15
ALERT_SUELO_MIN=30
ALERT_SUELO_MAX=90
ALERT_HR_MIN=30
ALERT_HR_MAX=90
ALERT_TEMP_MAX=35
ALERT_TEMP_MIN=5
ALERT_BATERIA_MIN=3.4
ALERT_RSSI_MIN=-85
ALERT_IGNORAR=sim-*,prueba-*  # nodos que no generan alertas
TZ_FINCA=America/Bogota

# --- Pronostico (Open-Meteo, sin API key) ----------------------------------
# Respaldo si ningun nodo tiene fix de GPS.
FINCA_LAT=
FINCA_LON=