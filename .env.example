# ============================================================================
#  IoT FIWARE + Agente IA  --  configuracion
#  Copiar a .env y rellenar. NUNCA subir .env a git (esta en .gitignore).
# ============================================================================

# --- FIWARE -----------------------------------------------------------------
ORION_HOST=orion
ORION_PORT=1026

# --- PostgreSQL / TimescaleDB (historial de lecturas) ----------------------
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot-local
DB_URL=postgresql://iot:iot-local@postgres:5432/iot

# --- Seguridad dispositivo -> servidor -------------------------------------
# El firmware (src/main.cpp) y el simulador usan ESTOS MISMOS valores.
# Generar: python3 -c "import secrets;print(secrets.token_hex(32))"
DEVICE_API_KEY=PEGAR_AQUI_LA_API_KEY_DEL_DISPOSITIVO
HMAC_SECRET=PEGAR_AQUI_EL_SECRETO_HMAC
MAX_SKEW_S=300
RATE_LIMIT_POR_MIN=12          # por clave de dispositivo
RATE_LIMIT_IP_POR_MIN=30       # por IP, se aplica ANTES de autenticar

# Una clave por dispositivo, separadas por coma. Si filtran una, el resto sigue
# intacto. Si se deja vacio, cae en DEVICE_API_KEY.
DEVICE_API_KEYS=

# --- Autenticacion de las interfaces web ----------------------------------
# Dashboard (puerto 8080) con HTTP basica. Para abrirlo desde el celular:
#   http://<WEB_USER>:<WEB_PASSWORD>@10.8.150.228:8080/dashboard/
WEB_USER=admin
WEB_PASSWORD=PEGAR_AQUI_UNA_CONTRASENA

# Clave para disparar un analisis del agente a mano (POST /api/agente/analizar).
AGENT_API_KEY=PEGAR_AQUI_UNA_CLAVE

# --- Agente IA (Gemini) -----------------------------------------------------
# >>> PEGAR AQUÍ TU API KEY DE GEMINI <<<
# Se puede dejar vacio: el agente queda en modo degradado y no llama a Gemini.
GEMINI_API_KEY=
# Google retira modelos y tiene picos de demanda: si el preferido falla con
# 404/429/5xx el agente prueba el siguiente de la lista.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest
GEMINI_REINTENTOS=2
AGENT_INTERVAL_MIN=15
# Cuanto mira hacia atras el agente en cada analisis (minutos).
AGENT_VENTANA_MIN=180
# Cuanto espera para considerar que el sensor esta muerto (minutos).
AGENT_SILENCIO_MIN=30

# --- TLS (opcional, perfil docker "tls") ------------------------------------
# Con esto el firmware puede enviar por https:// en vez de http://
# Activar:  docker compose --profile tls up -d
DOMAIN=cultivo.tudominio.com

# --- Grafana ----------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin